{
  "name": "rehype-og-card",
  "version": "3.1.15",
  "description": "Rehype plugin to convert text links to link cards",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "test": "vitest",
    "lint": "oxlint ./src",
    "format": "prettier --write ./src/**/*",
    "format:check": "prettier --check ./src/**/*",
    "build": "tsc",
    "version": "npm run build && git add .",
    "ci:version": "changeset version && npm run version",
    "ci:publish": "npm run build && changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robot-Inventor/rehype-og-card.git"
  },
  "keywords": [
    "markdown",
    "remark",
    "ogp",
    "unified",
    "rehype",
    "rehype-plugin"
  ],
  "author": "Robot-Inventor",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Robot-Inventor/rehype-og-card/issues"
  },
  "homepage": "https://github.com/Robot-Inventor/rehype-og-card#readme",
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@robot-inventor/oxlint-config": "^0.4.0",
    "@robot-inventor/tsconfig-base": "^7.2.0",
    "@types/node": "^26.6.2",
    "hast-util-to-html": "^9.0.5",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.8",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@types/hast": "^3.0.5",
    "arktype": "^2.2.3",
    "hast-util-is-element": "^3.0.0",
    "hastscript": "^9.0.1",
    "node-fetch": "^3.3.2",
    "open-graph-scraper": "^6.12.0",
    "unist-util-visit-parents": "^6.0.2"
  }
}
